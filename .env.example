# ─── Supabase ────────────────────────────────────────────────────────────────
# From your project's API settings: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose to the browser, never commit.
# Used for account creation and the billing webhook.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Public origin ───────────────────────────────────────────────────────────
# Every QR code encodes this at the moment it is generated. Set it correctly
# before your first business prints one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Billing (PayMongo — GCash, Maya, GrabPay, cards; PHP) ───────────────────
# Leave empty to run in manual mode: plan changes apply without a checkout.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────
# Apply the strict startup checks somewhere the platform isn't auto-detected.
# QYOFLOW_ENFORCE_ENV=1

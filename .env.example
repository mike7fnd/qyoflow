# Supabase — from your project's API settings (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser. Used for admin/webhook paths.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin, used to build QR codes and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Billing (PayMongo — GCash + cards, PHP). Optional in development:
# with no keys set, the app runs in "manual" billing mode and upgrades are
# recorded without a live checkout.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
